# Backend base URL (REST + WebSocket). Must be listed in the backend's FRONTEND_ORIGIN CORS config.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo only: let ?client=<id> in the URL choose the client identity (used with `make demo`).
# Leave unset anywhere real users go: the client id is the only credential.
# NEXT_PUBLIC_ALLOW_CLIENT_PARAM=1
