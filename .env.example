# Copy to .env and fill in. NEVER commit .env.

# --- Nebius Token Factory (OpenAI-compatible) ---
NEBIUS_API_KEY=
# VERIFY in the Token Factory dashboard; docs show more than one host.
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# --- NVIDIA Nemotron model IDs on Token Factory (run `make check-models` to list valid IDs) ---
MODEL_FAST=   # small Nemotron: per-utterance tagging, injection screening
MODEL_MID=    # mid Nemotron: persona, scammer simulator, orchestration
MODEL_DEEP=   # strongest Nemotron: final analysis + complaint

# json_prompt (implemented, default). `tools` / `auto` are reserved: native tool calling is probed by
# check_models.py but the client does not use it yet (see docs/HANDOVER.md backlog).
STRUCTURED_MODE=json_prompt
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=4
# Dev/test only: use the built-in mock LLM instead of the network.
LLM_OFFLINE=false
# Set true for reasoning models that return empty replies (hidden thinking eats the token budget)
LLM_DISABLE_THINKING=false

# --- Tavily (verification path) ---
TAVILY_API_KEY=

# --- Telegram family alerts (create bot via @BotFather) ---
TELEGRAM_BOT_TOKEN=

# --- Encryption at rest: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Voice (optional). Unset = browser Web Speech fallback (not an NVIDIA model) ---
ASR_BASE_URL=
TTS_BASE_URL=

# --- Storage ---
DATABASE_URL=sqlite+aiosqlite:///./data/scamkhel.db
RETENTION_DAYS=30

# --- Public demo protection ---
DEMO_MODE=false
DAILY_TOKEN_BUDGET=500000
PER_IP_SESSIONS_PER_HOUR=6
MAX_TURNS_PER_SESSION=20
ADMIN_TOKEN=
FRONTEND_ORIGIN=http://localhost:3000
# Addresses or subnets of reverse proxies in front of the API (comma-separated), e.g.
# "127.0.0.1, ::1, 10.0.0.0/8". Empty = X-Forwarded-For is ignored and the socket address is
# used (safe default). Behind a proxy list the proxy's own address(es) so the per-IP limits see
# the real client instead of treating every visitor as the proxy.
TRUSTED_PROXIES=
