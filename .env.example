# Copy to .env and fill in. NEVER commit .env.

# --- Nebius Token Factory (OpenAI-compatible) ---
NEBIUS_API_KEY=
# VERIFY in the Token Factory dashboard; docs show more than one host.
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# --- NVIDIA Nemotron model IDs on Token Factory (run `make check-models` to list valid IDs) ---
MODEL_FAST=   # small Nemotron: per-utterance tagging, injection screening
MODEL_MID=    # mid Nemotron: persona, scammer simulator, orchestration
MODEL_DEEP=   # strongest Nemotron: final analysis + complaint

# auto | json_prompt | tools  (check_models.py recommends one; json_prompt is the safe default)
STRUCTURED_MODE=json_prompt
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=4
# Dev/test only: use the built-in mock LLM instead of the network.
LLM_OFFLINE=false

# --- Tavily (verification path) ---
TAVILY_API_KEY=

# --- Telegram family alerts (create bot via @BotFather) ---
TELEGRAM_BOT_TOKEN=

# --- Encryption at rest: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Voice (optional). Unset = browser Web Speech fallback (not an NVIDIA model) ---
ASR_BASE_URL=
TTS_BASE_URL=

# --- Storage ---
DATABASE_URL=sqlite+aiosqlite:///./data/scamkhel.db
RETENTION_DAYS=30

# --- Public demo protection ---
DEMO_MODE=false
DAILY_TOKEN_BUDGET=500000
PER_IP_SESSIONS_PER_HOUR=6
MAX_TURNS_PER_SESSION=20
ADMIN_TOKEN=
FRONTEND_ORIGIN=http://localhost:3000
